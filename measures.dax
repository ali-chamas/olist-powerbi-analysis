// Calculated column on Sales
Delay Bucket = SWITCH ( TRUE (), ISBLANK ( Sales[delivered_date] ), "Not delivered", Sales[delay_days] <= 0, "1 · On time", Sales[delay_days] <= 7, "2 · 1–7 days late", "3 · 8+ days late" )

// Measures (stored in a dedicated _Measures table)
Revenue = SUM ( Sales[revenue] )
Orders = DISTINCTCOUNT ( Sales[order_id] )
Items Sold = COUNTROWS ( Sales )
Customers = DISTINCTCOUNT ( Sales[customer_key] )
Average Order Value = DIVIDE ( [Revenue], [Orders] )
Delivered Revenue = CALCULATE ( [Revenue], Sales[order_status] = "delivered" )
Repeat Customer Rate = DIVIDE ( CALCULATE ( DISTINCTCOUNT ( Customers[customer_key] ), Customers[is_repeat_customer] = 1 ), DISTINCTCOUNT ( Customers[customer_key] ) )
Repeat Order Share = DIVIDE ( CALCULATE ( [Orders], Sales[is_repeat_order] = 1 ), [Orders] )
Average Review = AVERAGEX ( VALUES ( Sales[order_id] ), CALCULATE ( MAX ( Sales[review_score] ) ) )
Delivered Orders = CALCULATE ( [Orders], NOT ISBLANK ( Sales[delivered_date] ) )
Late Delivery Rate = DIVIDE ( CALCULATE ( [Orders], Sales[is_late] = 1 ), [Delivered Orders] )
Average Delivery Days = AVERAGEX ( VALUES ( Sales[order_id] ), CALCULATE ( MAX ( Sales[delivery_days] ) ) )
Revenue Previous Month = CALCULATE ( [Revenue], DATEADD ( Dates[date], -1, MONTH ) )
Revenue MoM % = DIVIDE ( [Revenue] - [Revenue Previous Month], [Revenue Previous Month] )
Cohort Size = CALCULATE ( DISTINCTCOUNT ( Sales[customer_key] ), Sales[months_since_first] = 0, REMOVEFILTERS ( Sales[months_since_first] ) )
Retention % = DIVIDE ( [Customers], [Cohort Size] )
